# ============================================================
# Variáveis de ambiente do GestãoHVU (ambiente local)
# Copie este arquivo para .env e ajuste os valores conforme necessário.
#
#   cp .env.example .env
#
# NUNCA versione o arquivo .env (ele está no .gitignore).
# Este arquivo não contém credenciais reais.
# ============================================================

# --- Banco de dados do backend (PostgreSQL) ---
HVU_DB_URL=jdbc:postgresql://backend-db:5432/hvu?stringtype=unspecified
HVU_DB_USERNAME=postgres
HVU_DB_PASSWORD=change-me
HVU_DB_NAME=hvu

# --- Banco de dados do Keycloak ---
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=change-me

# --- Keycloak ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_REALM=lmts
KEYCLOAK_CLIENT_ID=create_user
KEYCLOAK_CLIENT_SECRET=change-me

# --- Frontend (expostas no build do Next.js via NEXT_PUBLIC_*) ---
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=create_user
NEXT_PUBLIC_KEYCLOAK_CLIENT_SECRET=change-me
